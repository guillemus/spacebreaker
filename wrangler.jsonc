{
	// Static deploy of the web build: run ./build_web.sh, then `bunx wrangler deploy`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "starbreaker",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./build/web",
		"not_found_handling": "single-page-application"
	}
}
